{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/verificar-resumen.sh\"",
            "timeout": 30,
            "statusMessage": "Verificando que los resúmenes coincidan con el cuerpo..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/validar-build-mistorias-web.sh\"",
            "timeout": 600,
            "statusMessage": "Validando historias contra el build de mistorias-web...",
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "Validación de build de mistorias-web"
          }
        ]
      }
    ]
  }
}
